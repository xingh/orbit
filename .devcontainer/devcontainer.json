{
  "name": "Orbit",
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    // Node 22 and Rust stable are what CI uses; rustfmt is what `cargo fmt --check` needs and
    // clippy is what review asks for. gh backs the `.manage/manage` workflow.
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "default",
      "targets": "x86_64-unknown-linux-gnu"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Orbit is a window, not a web page. This serves a real desktop over noVNC at
    // http://localhost:6080 so `pnpm tauri dev` has somewhere to open.
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },

  "containerEnv": {
    // Every GUI tool in here defaults to the noVNC desktop rather than failing with "no display".
    "DISPLAY": ":1"
  },

  // A rebuild should not re-download crates.io or relink the whole dependency graph.
  "mounts": [
    "source=orbit-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=orbit-cargo-target,target=${containerWorkspaceFolder}/src-tauri/target,type=volume",
    "source=orbit-pnpm-store,target=/home/vscode/.local/share/pnpm/store,type=volume"
  ],

  "forwardPorts": [1420, 6080, 41479, 41480, 41481, 41482, 41483],
  "portsAttributes": {
    "1420": { "label": "Vite dev server" },
    "6080": { "label": "Desktop (noVNC)", "onAutoForward": "notify" },
    "41479": { "label": "Orbit companion service" }
  },

  // A named volume starts owned by root, so the first thing it needs is an owner.
  "onCreateCommand": "sudo chown -R vscode:vscode /usr/local/cargo/registry ${containerWorkspaceFolder}/src-tauri/target /home/vscode/.local/share/pnpm",
  "postCreateCommand": ".devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tauri-apps.tauri-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python"
      ],
      "settings": {
        "rust-analyzer.linkedProjects": ["src-tauri/Cargo.toml"],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "remoteUser": "vscode"
}
