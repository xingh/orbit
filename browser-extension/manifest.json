{
  "manifest_version": 3,
  "name": "Orbit Link",
  "version": "0.3.0",
  "description": "Save chat titles and links straight into your Orbit companion. No login or chat content access.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "link@orbit.tekt.md",
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Orbit",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  }
}
