{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit Companion",
  "version": "0.1.0",
  "identifier": "com.orbit.companion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Orbit Companion", "width": 510, "height": 820,
      "decorations": false, "transparent": true, "alwaysOnTop": true,
      "resizable": false, "shadow": false, "skipTaskbar": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
